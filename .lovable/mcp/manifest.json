{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://wcuvhugwfbeixoocngjo.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "revisemaster-mcp",
      "version": "0.1.0",
      "title": "ReviseMaster"
    },
    "tools": [
      {
        "name": "list_decks",
        "title": "List decks",
        "description": "List the signed-in user's flashcard decks (newest first).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Max decks to return (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_deck",
        "title": "Get deck with cards",
        "description": "Fetch a single deck and its flashcards by deck id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "deck_id": {
              "type": "string",
              "format": "uuid",
              "description": "Deck UUID."
            },
            "cards_limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "description": "Max cards (default 200)."
            }
          },
          "required": [
            "deck_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_deck",
        "title": "Create deck",
        "description": "Create a new flashcard deck for the signed-in user, optionally with initial cards (front/back pairs).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "Deck name."
            },
            "description": {
              "type": "string",
              "maxLength": 500,
              "description": "Optional deck description."
            },
            "cards": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "front": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "back": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "front",
                  "back"
                ],
                "additionalProperties": false
              },
              "maxItems": 500,
              "description": "Optional initial cards."
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_cards",
        "title": "Add cards to deck",
        "description": "Append flashcards to an existing deck owned by the signed-in user.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "deck_id": {
              "type": "string",
              "format": "uuid",
              "description": "Target deck UUID."
            },
            "cards": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "front": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "back": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "front",
                  "back"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 500
            }
          },
          "required": [
            "deck_id",
            "cards"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_due_cards",
        "title": "List due cards",
        "description": "List the signed-in user's cards that are due for review right now, across all decks.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "description": "Max cards (default 50)."
            },
            "deck_id": {
              "type": "string",
              "format": "uuid",
              "description": "Optional deck filter."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
